# ─── KiCad ────────────────────────────────────────────────────────────────────
# Auto-generated cache / local prefs — not needed in version control
fp-info-cache
*.kicad_prl
# KiCad auto-save
_autosave-*
# KiCad backups dir (large, auto-regenerated)
*-backups/
# Production output zips (regenerate from design files)
production/*.zip
production/backups/

